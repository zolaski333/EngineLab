// Explicit public state schema for lifecycle/nonvariable bit identity; padding is excluded.
template<class T> void hashField(std::uint64_t& hash, const T& value) {
    if constexpr (std::is_floating_point_v<T>) {
        if constexpr (sizeof(T) == 8) hashWord(hash, std::bit_cast<std::uint64_t>(value));
        else hashWord(hash, std::bit_cast<std::uint32_t>(value));
    } else if constexpr (std::is_integral_v<T> || std::is_enum_v<T>) {
        hashWord(hash, static_cast<std::uint64_t>(value));
    } else {
        for (const auto& item : value) hashField(hash, item);
    }
}
